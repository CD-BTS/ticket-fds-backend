# Copy to .env for Docker Compose and fill in credentials locally.
# Spring Boot does not load .env automatically; export DB_* variables separately.
DB_URL=jdbc:mysql://localhost:3306/fairticket_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JPA_SHOW_SQL=false
# User API: JSON object of service ID -> SHA-256 API Key hash (never the raw key).
# Export separately for Spring Boot; an empty object rejects all user API requests.
BTS_API_KEY_HASHES={}

# Administrator keys: JSON array; hashes only. Export separately for Spring Boot.
# Scoped: {"hash":"<64 hex SHA-256>","allServices":false,"services":["ticket-service-a"]}
# Global: {"hash":"<different 64 hex SHA-256>","allServices":true,"services":[]}
# Empty/missing blocks administrator credentials. Never reuse service keys.
BTS_ADMIN_API_KEYS=[]
